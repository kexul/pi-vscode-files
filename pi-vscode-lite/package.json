{
  "name": "pi-vscode-lite",
  "displayName": "Pi VS Code Lite",
  "description": "Lightweight bridge for pi - only provides open files API",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piDiffReview.accept",
        "title": "Pi Diff Review: Accept"
      },
      {
        "command": "piDiffReview.reject",
        "title": "Pi Diff Review: Reject"
      }
    ]
  }
}
